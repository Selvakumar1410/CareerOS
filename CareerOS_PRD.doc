  "total": 42,
  "by_status": { "Applied": 18, "Shortlisted": 9, "Assessment": 5,
                 "Interview": 6, "Offer": 2, "Rejected": 2 },
  "conversion": { "applied_to_shortlisted": 57.1, "overall_offer_rate": 4.8 },
  "upcoming_interviews": [
    { "id": 31, "company": "Stripe", "role": "Backend Engineer",
      "interview_date": "2026-08-14" }
  ]
}</pre>
            <h3>10.3 Gmail</h3>
            <table>
                <tbody><tr>
                    <th>Method</th>
