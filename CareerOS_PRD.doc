                    <td>✓</td>
                </tr>
            </tbody></table>
            <h3>10.2 Jobs</h3>
            <table>
                <tbody><tr>
                    <th>Method</th>
                    <th>Endpoint</th>
                    <th>Description</th>
                    <th>Auth</th>
                </tr>
                <tr>
                    <td>GET</td>
                    <td><code>/api/jobs</code></td>
                    <td>List applications. Query params: <code>status</code>, <code>source</code>, <code>q</code></td>
