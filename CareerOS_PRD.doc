                </tr>
                <tr>
                    <td>POST</td>
                    <td><code>/auth/login</code></td>
                    <td>Session login <code>{email, password}</code></td>
                    <td>✗</td>
                </tr>
                <tr>
                    <td>POST</td>
                    <td><code>/auth/logout</code></td>
                    <td>Destroy session</td>
